# ──────────────────────────────────────────
# ClickML Pro — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# ── Core ──
CLICKML_ENV=development
CLICKML_SECRET_KEY=change-me-in-production
CLICKML_API_HOST=0.0.0.0
CLICKML_API_PORT=8000
CLICKML_LOG_LEVEL=INFO

# ── Database ──
CLICKML_DB_URL=postgresql+asyncpg://clickml:clickml@localhost:5432/clickml_pro
CLICKML_DB_ECHO=false

# ── Redis / Celery ──
CLICKML_REDIS_URL=redis://localhost:6379/0
CLICKML_CELERY_BROKER=redis://localhost:6379/1
CLICKML_CELERY_BACKEND=redis://localhost:6379/2

# ── AWS (optional — for artifact storage) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLICKML_S3_BUCKET=clickml-pro-artifacts

# ── Model Registry ──
CLICKML_REGISTRY_BACKEND=local
CLICKML_REGISTRY_PATH=./registry

# ── Training ──
CLICKML_DEFAULT_DEVICE=auto
CLICKML_CHECKPOINT_DIR=./checkpoints
CLICKML_WANDB_PROJECT=clickml-pro

# ── Governance ──
CLICKML_GPU_QUOTA_DEFAULT=100
CLICKML_BUDGET_LIMIT_USD=500.0

# ── Airflow (data pipelines) ──
AIRFLOW_HOME=./airflow_home
AIRFLOW__CORE__EXECUTOR=LocalExecutor
